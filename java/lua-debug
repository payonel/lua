#!/bin/sh
JDK=${JDK:-$HOME/.gradle/jdks/eclipse_adoptium-25-amd64-linux.2}
jar=$(dirname "$0")/build/lua.jar
if env --default-signal=INT true 2>/dev/null; then
  exec env --default-signal=INT "$JDK/bin/java" -XX:-DontCompileHugeMethods -ea -Dlua.debug=true -Dlua.progname="$0" -jar "$jar" "$@"
fi
exec "$JDK/bin/java" -XX:-DontCompileHugeMethods -ea -Dlua.debug=true -Dlua.progname="$0" -jar "$jar" "$@"
