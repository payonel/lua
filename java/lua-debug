#!/bin/sh
dir=$(dirname "$0")
JDK=${JDK:-$(cat "$dir/build/jdk")}
jar=$dir/build/lungolua.jar
tests=$dir/build/lungolua-tests.jar
set -- -cp "$jar:$tests" com.payonel.lungolua.host.Lua "$@"
# the AOT cache ('make -C java'), when it is newer than the jar and the JDK
# is the build's; where the cache does not match, the JVM starts without it
# and says nothing
if [ "$dir/build/lungolua.aot" -nt "$jar" ] && [ "$dir/build/lungolua.aot" -nt "$tests" ] && [ "$JDK" = "$(cat "$dir/build/jdk")" ]; then
  set -- "-XX:AOTCache=$dir/build/lungolua.aot" "-Xlog:aot*=off" "$@"
fi
# the JVM converts paths, commands and the environment with the charset of
# its locale: where that is not UTF-8, it runs in C.UTF-8 and is told the
# locale's variables as they were, to give them back (Environ.java)
if [ "$(locale charmap 2>&1)" != UTF-8 ]; then
  if [ "${LANG+set}" ]; then set -- "-Dlua.env.LANG=$LANG" "$@"; fi
  if [ "${LC_CTYPE+set}" ]; then set -- "-Dlua.env.LC_CTYPE=$LC_CTYPE" "$@"; fi
  if [ "${LC_ALL+set}" ]; then set -- "-Dlua.env.LC_ALL=$LC_ALL" "$@"; fi
  set -- -Dlua.env=LC_ALL,LC_CTYPE,LANG "$@"
  LC_ALL=C.UTF-8
  export LC_ALL
fi
if env --default-signal=INT true 2>/dev/null; then
  exec env --default-signal=INT "$JDK/bin/java" --enable-native-access=ALL-UNNAMED -ea -Dlua.debug=true -Dlua.progname="$0" "$@"
fi
exec "$JDK/bin/java" --enable-native-access=ALL-UNNAMED -ea -Dlua.debug=true -Dlua.progname="$0" "$@"
