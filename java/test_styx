#!/bin/sh
dir=$(dirname "$0")
JDK=${JDK:-$(cat "$dir/build/jdk")}
jar=$dir/build/lua.jar
debug=
if [ "$LUA_JAVA_DEBUG" = 1 ]; then
  debug="-ea -Dlua.debug=true"
fi
if env --default-signal=INT true 2>/dev/null; then
  exec env --default-signal=INT "$JDK/bin/java" -XX:-DontCompileHugeMethods $debug -Dstyx.self="$0" -Dstyx.source="$dir/src/lua/tests/StyxTests.java" -cp "$jar" lua.tests.StyxTests "$@"
fi
exec "$JDK/bin/java" -XX:-DontCompileHugeMethods $debug -Dstyx.self="$0" -Dstyx.source="$dir/src/lua/tests/StyxTests.java" -cp "$jar" lua.tests.StyxTests "$@"
