#!/bin/sh
dir=$(dirname "$0")
JDK=${JDK:-$(cat "$dir/build/jdk")}
jar=$dir/build/lua.jar
if env --default-signal=INT true 2>/dev/null; then
  exec env --default-signal=INT "$JDK/bin/java" -XX:-DontCompileHugeMethods -Dlua.progname="$0" -jar "$jar" "$@"
fi
exec "$JDK/bin/java" -XX:-DontCompileHugeMethods -Dlua.progname="$0" -jar "$jar" "$@"
