#!/bin/sh
dir=$(dirname "$0")
JDK=${JDK:-$(cat "$dir/build/jdk")}
jar=$dir/build/lua.jar
debug=
lua=$dir/lua
if [ "$LUA_JAVA_DEBUG" = 1 ]; then
  debug="-ea -Dlua.debug=true"
  lua=$dir/lua-debug
fi
GATE_LUA=${GATE_LUA:-$lua}
export GATE_LUA
if env --default-signal=INT true 2>/dev/null; then
  exec env --default-signal=INT "$JDK/bin/java" -XX:-DontCompileHugeMethods $debug -Dlua.progname="$0" -cp "$jar" lua.tests.Gate "$@"
fi
exec "$JDK/bin/java" -XX:-DontCompileHugeMethods $debug -Dlua.progname="$0" -cp "$jar" lua.tests.Gate "$@"
