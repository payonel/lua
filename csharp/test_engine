#!/bin/sh
dir=$(dirname "$0")
DOTNET=${DOTNET:-$(cat "$dir/build/dotnet")}
debug=
if [ "$LUA_CS_DEBUG" = 1 ]; then
  debug=-Dlua.debug=true
fi
if env --default-signal=INT true 2>/dev/null; then
  exec env --default-signal=INT "$DOTNET" "$dir/build/lungolua-tests.dll" $debug -Dlua.progname="$0" EngineTests "$@"
fi
exec "$DOTNET" "$dir/build/lungolua-tests.dll" $debug -Dlua.progname="$0" EngineTests "$@"
